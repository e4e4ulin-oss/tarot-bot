# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Чат, куда падают заявки на авторский разбор.
# Это может быть личка Анастасии с ботом или закрытая группа.
# Узнать id: запустите бота и отправьте ему /chatid (пример: -1001234567890)
ADMIN_CHAT_ID=

# Telegram id тех, кто может отвечать на заявки, через запятую (пример: 111111111,222222222)
ADMIN_IDS=

# --- Автор -------------------------------------------------------------------
AUTHOR_NAME=Анастасия
# Необязательно: показывается перед оформлением заявки
AUTHOR_PRICE_TEXT=

# --- Языковая модель ------------------------------------------------------------
# Подойдёт любой OpenAI-совместимый провайдер. Без ключа бот работает, но
# авто-разбор отдаёт базовые значения карт вместо связного текста.
#
# Бесплатные варианты (проверьте актуальные лимиты у провайдера):
#   Google Gemini  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                  AI_MODEL=gemini-2.5-flash
#   Groq           AI_BASE_URL=https://api.groq.com/openai/v1
#                  AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter     AI_BASE_URL=https://openrouter.ai/api/v1
#                  AI_MODEL=<модель с суффиксом :free>
#   xAI (платный)  AI_BASE_URL=https://api.x.ai/v1
#                  AI_MODEL=grok-4
AI_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4

# Таймаут одного запроса и общий предел ожидания вместе с повтором
GROK_TIMEOUT=30
GROK_DEADLINE=45
GROK_RETRIES=1
GROK_MAX_TOKENS=1200
GROK_TEMPERATURE=0.8

# --- Хранилище ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/tarot.db

# --- Картинки карт -----------------------------------------------------------
# Картинки берутся с Викисклада (колода Райдера-Уэйта, общественное достояние).
# Своя фотография карты кладётся в bot/tarot/data/cards/<id карты>.jpg и имеет
# приоритет: major_00.jpg, cups_01.jpg, wands_14.jpg и так далее.
SEND_CARD_IMAGES=true
# Раскладам крупнее этого числа карт картинки не отправляются
IMAGE_CARDS_LIMIT=3

# --- Правила работы ----------------------------------------------------------
# Сколько авто-раскладов один человек может сделать за сутки (0 — без лимита)
DAILY_AUTO_LIMIT=5
ALLOW_REVERSED=true
REVERSED_CHANCE=0.4
MAX_QUESTION_LENGTH=500
LOG_LEVEL=INFO
