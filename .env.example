# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Чат, куда падают заявки на авторский разбор.
# Это может быть личка Анастасии с ботом или закрытая группа.
# Узнать id: запустите бота и отправьте ему /chatid (пример: -1001234567890)
ADMIN_CHAT_ID=

# Telegram id тех, кто может отвечать на заявки, через запятую (пример: 111111111,222222222)
ADMIN_IDS=

# --- Автор -------------------------------------------------------------------
AUTHOR_NAME=Анастасия
# Необязательно: показывается перед оформлением заявки
AUTHOR_PRICE_TEXT=

# --- Grok (xAI) --------------------------------------------------------------
# Ключ с console.x.ai. Без него бот работает, но авто-разбор отдаёт
# базовые значения карт из своей базы вместо связного текста.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Модель. Рассуждающие модели отвечают дольше — если разбор идёт долго,
# попробуйте более быструю модель из вашего аккаунта xAI.
GROK_MODEL=grok-4
# Таймаут одного запроса и общий предел ожидания вместе с повтором
GROK_TIMEOUT=30
GROK_DEADLINE=45
GROK_RETRIES=1
GROK_MAX_TOKENS=1200
GROK_TEMPERATURE=0.8

# --- Хранилище ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/tarot.db

# --- Правила работы ----------------------------------------------------------
# Сколько авто-раскладов один человек может сделать за сутки (0 — без лимита)
DAILY_AUTO_LIMIT=5
ALLOW_REVERSED=true
REVERSED_CHANCE=0.4
MAX_QUESTION_LENGTH=500
LOG_LEVEL=INFO
