# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Чат, куда падают заявки на авторский разбор: личка с ботом или закрытая группа.
# Узнать id: запустите бота и отправьте ему /chatid (пример: -1001234567890)
ADMIN_CHAT_ID=

# Кто ведёт заявки: id через запятую (пример: 111111111,222222222).
# Заявка приходит каждому из них и в ADMIN_CHAT_ID, отвечать может любой.
ADMIN_IDS=

# --- Автор -------------------------------------------------------------------
# Как бот называет автора разборов: имя или просто «таролог»
AUTHOR_NAME=таролог
# Необязательно: показывается перед оформлением заявки
AUTHOR_PRICE_TEXT=

# Цены уровней авторского разбора. 0 — уровень не предлагается клиенту
AUTHOR_PRICE_SHORT=500
AUTHOR_PRICE_BASE=700
AUTHOR_PRICE_FULL=1000
AUTHOR_CURRENCY=₽

# --- Карта дня ---------------------------------------------------------------
DAILY_CARD_ENABLED=true
# Час утренней рассылки в часовом поясе ниже
DAILY_CARD_HOUR=9
# Сколько сообщений уходит за один проход рассылки
DAILY_CARD_BATCH=25

# --- Рабочее время -----------------------------------------------------------
# Срок ответа на авторский разбор тратится только в эти часы, ПН–ПТ
WORK_START_HOUR=9
WORK_END_HOUR=18
WORK_TIMEZONE=Europe/Moscow
WORK_TIMEZONE_LABEL=мск
# Какая доля срока должна уместиться в рабочее время, чтобы доработать сегодня.
# 0.75: заявка в 16:30 со сроком 2 часа доводится до 18:30, а в 17:00 — переносится
WORK_OVERFLOW_SHARE=0.75

# --- Языковая модель ------------------------------------------------------------
# Подойдёт любой OpenAI-совместимый провайдер. Без ключа бот работает, но
# авто-разбор отдаёт базовые значения карт вместо связного текста.
#
# Бесплатные варианты (проверьте актуальные лимиты у провайдера):
#   Google Gemini  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                  AI_MODEL=gemini-2.5-flash
#                  (доступен из России только через VPN при получении ключа)
#   Groq           AI_BASE_URL=https://api.groq.com/openai/v1
#                  AI_MODEL=openai/gpt-oss-120b
#                  (список моделей меняется: console.groq.com/docs/models)
#   OpenRouter     AI_BASE_URL=https://openrouter.ai/api/v1
#                  AI_MODEL=<модель с суффиксом :free>
#   xAI (платный)  AI_BASE_URL=https://api.x.ai/v1
#                  AI_MODEL=grok-4
AI_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4

# Таймаут одного запроса и общий предел ожидания вместе с повтором
GROK_TIMEOUT=30
GROK_DEADLINE=45
GROK_RETRIES=1
GROK_MAX_TOKENS=3000
GROK_TEMPERATURE=0.8

# --- Бесплатные расклады --------------------------------------------------------
# Подписан на карту дня — пять бесплатных, отключил — два. Потраченное не
# возвращается: отписавшийся на третьем раскладе остаётся ни с чем, а
# вернувшийся получает обратно свой остаток. Больше двух в день не потратить —
# пять раскладов это три дня, а не один вечер. Потолок только на бесплатные.
FREE_AUTO_READINGS=5
FREE_WITHOUT_DAILY=2
FREE_DAILY_LIMIT=2
FREE_NEEDS_DAILY=true
DAILY_SUBSCRIBE_NEW=true

# --- Напоминание про карту дня --------------------------------------------------
# Тем, кто зашёл, но не подписался: подписка открывает бесплатные расклады, и
# человек может просто об этом не знать. Предел и пауза — чтобы напоминание не
# стало рассылкой, а бот — поводом для блокировки.
NUDGE_ENABLED=true
NUDGE_HOUR=12
NUDGE_AFTER_HOURS=20
NUDGE_EVERY_DAYS=7
NUDGE_MAX=3

# --- Приглашения ---------------------------------------------------------------
# Бесплатные расклады за приглашённого друга. Пригласившему начисляется, когда
# тот сделал первый расклад, а не когда нажал «старт»: за нажатие платят спамеры.
REFERRAL_BONUS=2
REFERRAL_WELCOME=1

# --- Хранилище ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/tarot.db

# --- Картинки карт -----------------------------------------------------------
# Картинки берутся с Викисклада (колода Райдера-Уэйта, общественное достояние).
# Своя фотография карты кладётся в bot/tarot/data/cards/<id карты>.jpg и имеет
# приоритет: major_00.jpg, cups_01.jpg, wands_14.jpg и так далее.
SEND_CARD_IMAGES=true
# Раскладам крупнее этого числа карт картинки не отправляются
IMAGE_CARDS_LIMIT=3

# --- Правила работы ----------------------------------------------------------
# Сколько авто-раскладов один человек может сделать за сутки (0 — без лимита)
DAILY_AUTO_LIMIT=5
ALLOW_REVERSED=true
REVERSED_CHANCE=0.4
MAX_QUESTION_LENGTH=500
LOG_LEVEL=INFO

# --- Управление службой из Telegram (/update, /restart, /logs) ---------------
# Нужны, только если служба названа иначе или скрипт обновления лежит не там
# SERVICE_NAME=tarot-bot
# UPDATE_SCRIPT=/usr/local/bin/tarot-update
