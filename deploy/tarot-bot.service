[Unit]
Description=Tarot Telegram bot
After=network-online.target
Wants=network-online.target
# Падающий бот не должен запереть себя насовсем: systemd по умолчанию
# сдаётся после пяти попыток за десять секунд и дальше ждёт человека.
# Ключ действует только здесь, в [Unit]: в [Service] systemd его игнорирует.
StartLimitIntervalSec=0

[Service]
Type=simple
User=tarot
WorkingDirectory=/opt/tarot-bot
EnvironmentFile=/opt/tarot-bot/.env
ExecStart=/opt/tarot-bot/.venv/bin/python -m bot
Restart=always
# Полминуты между попытками: бот перезапускается, пока не поднимется, и
# секундный шаг означал бы сотню заходов в базу и в Telegram ни за чем
RestartSec=30

[Install]
WantedBy=multi-user.target
